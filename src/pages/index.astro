---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Get base path from Astro config
const base = import.meta.env.BASE_URL;

// Fetch all artists and images
const allArtists = await getCollection('artists');
const allImages = await getCollection('images');

// Calculate image counts for each artist
const artistsWithCounts = allArtists.map(artist => {
  const artistSlug = artist.id.replace(/\.md$/, '');
  const imageCount = allImages.filter(img => img.data.artist === artistSlug).length;
  return {
    ...artist,
    artistSlug,
    imageCount
  };
});

// Get a sample image for each artist (first image)
const artistPreviews = artistsWithCounts.map(artist => {
  const firstImage = allImages.find(img => img.data.artist === artist.artistSlug);
  return {
    artist: artist.data,
    artistSlug: artist.artistSlug,
    imageCount: artist.imageCount,
    previewImage: firstImage
  };
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>The Gilded Pixel</title>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen bg-pattern">
		<!-- Decorative corner ornaments -->
		<div class="gilded-frame top-left"></div>
		<div class="gilded-frame top-right"></div>
		<div class="gilded-frame bottom-left"></div>
		<div class="gilded-frame bottom-right"></div>

		<div class="container-elegant py-12 fade-in-up">
			<!-- Header -->
			<div class="mb-12 stagger-children">
				<h1 class="text-5xl md:text-6xl heading-gold mb-3">The Gilded Pixel</h1>
				<p class="subtitle-elegant mb-6">Where prompts meet polish.</p>

				<!-- Total image count with elegant styling -->
				<p class="text-muted text-sm uppercase tracking-wide">
					{allImages.length} images · {allArtists.length} {allArtists.length === 1 ? 'gallery' : 'galleries'}
				</p>
			</div>

			<div class="divider-gold"></div>

			<!-- Artist Selection Grid -->
			<h2 class="text-3xl font-bold text-text mb-8 mt-12">Featured Artists</h2>
			<div class="gallery-grid gallery-grid-lg">
				{artistPreviews.map((preview) => (
					<a
						href={`${base}/artist/${preview.artistSlug}`}
						class="gallery-card aspect-portrait group cursor-pointer block"
					>
						<div class="image-wrapper overflow-hidden rounded-lg relative h-full">
							{preview.previewImage && (
								<Image
									src={preview.previewImage.data.src}
									alt={`Preview of ${preview.artist.name}'s work`}
									width={preview.previewImage.data.width}
									height={preview.previewImage.data.height}
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
									loading="lazy"
								/>
							)}
							<!-- Artist info overlay with enhanced design -->
							<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-400 flex flex-col justify-end p-6">
								<h3 class="text-gold-bright font-bold text-xl mb-1 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-400">
									{preview.artist.name}
								</h3>
								<p class="text-steel text-sm font-medium transform translate-y-4 group-hover:translate-y-0 transition-transform duration-400 delay-75">
									{preview.imageCount} {preview.imageCount === 1 ? 'image' : 'images'}
								</p>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</body>
</html>
