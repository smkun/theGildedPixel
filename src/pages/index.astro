---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Fetch all images from Content Collections
const allImages = await getCollection('images');

// Prepare image data for lightbox (client-side)
const imageData = allImages.map(img => ({
  src: img.data.src,
  width: img.data.width,
  height: img.data.height
}));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>AI Image Gallery</title>
	</head>
	<body class="min-h-screen">
		<div class="container mx-auto px-4 py-8">
			<h1 class="text-4xl font-bold text-gold mb-8">AI Character Gallery</h1>

			<!-- Image count -->
			<p class="text-muted mb-6">{allImages.length} images</p>

			<!-- Gallery Grid -->
			<div class="gallery-grid" id="gallery-grid">
				{allImages.map((image, index) => (
					<div
						class="gallery-card aspect-portrait group cursor-pointer"
						data-index={index}
					>
						<div class="image-wrapper overflow-hidden rounded-lg">
							<Image
								src={image.data.src}
								alt=""
								width={image.data.width}
								height={image.data.height}
								class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
								loading="lazy"
							/>
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- Lightbox Script -->
		<script define:vars={{ imageData }}>
			import Lightbox from '../components/Lightbox.ts';

			// Initialize lightbox
			const lightbox = new Lightbox(imageData);

			// Attach click handlers to gallery cards
			const galleryGrid = document.getElementById('gallery-grid');
			galleryGrid?.addEventListener('click', (e) => {
				const card = (e.target as HTMLElement).closest('[data-index]');
				if (card) {
					const index = parseInt(card.getAttribute('data-index') || '0');
					lightbox.open(index);
				}
			});
		</script>
	</body>
</html>
